{
  "name": "remirror",
  "version": "0.3.8",
  "description": "ADHD-aware screen-attention recorder. All data local.",
  "main": "out/main/index.js",
  "type": "module",
  "author": "Remirror",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jdeildale/remirror.git"
  },
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.18.0"
  },
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "electron-vite build",
    "build:win": "npm run rebuild:electron && npm run build && electron-builder --win --config electron-builder.yml",
    "release:win": "npm run rebuild:electron && npm run build && electron-builder --win --config electron-builder.yml --publish always",
    "pretest": "npm run rebuild:node",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "npm run rebuild:node && vitest",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f --build-from-source",
    "build:icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@google-cloud/local-auth": "^3.0.1",
    "better-sqlite3": "^11.5.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "get-windows": "^9.2.0",
    "googleapis": "^172.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uiohook-napi": "^1.5.4",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
